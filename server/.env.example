# ===== 课堂加分服务端 · 环境变量示例 =====
# 复制成 .env 后按需修改。所有配置都走环境变量，禁止把密钥写进镜像。

# ---- 运行环境 ----
# dev | staging | prod
NODE_ENV=dev

# ---- 监听 ----
PORT=3000
# 只给本机访问用 127.0.0.1；要让局域网/外网访问改 0.0.0.0
HOST=127.0.0.1

# ---- 数据库 ----
# sqlite | pg
# 本机没有 PostgreSQL 时用 sqlite（Node 内置 node:sqlite，零依赖）
DB_DRIVER=sqlite
SQLITE_FILE=./data/rollcall.db
# DB_DRIVER=pg 时必填，例如：
# DATABASE_URL=postgres://rollcall:password@127.0.0.1:5432/rollcall

# ---- 会话 ----
COOKIE_NAME=rc_sid
# 生产（HTTPS）必须 true，否则启动会直接报错退出
COOKIE_SECURE=false
# 空闲超时（分钟）
SESSION_IDLE_MIN=30
# 绝对超时（分钟，12 小时）
SESSION_ABS_MIN=720

# ---- 登录限流 ----
LOGIN_WINDOW_MIN=10
LOGIN_MAX_FAILS=5

# ---- 静态资源 ----
# 前端根目录，默认指向 rollcall/（server 的上一级）
STATIC_DIR=../

# ---- 内置管理员 ----
# 最高管理员是代码内置的（src/auth/seed.ts）：账号 wjqcool，姓名「深之一」，
# 密码只以 scrypt 哈希存储，无法用环境变量覆盖，也不会随机生成。
# 首次启动自动创建；之后请在「账号 → 修改密码」里换成自己的密码。

# ---- 其他 ----
DEFAULT_SCHOOL_CODE=default
# 是否在 /healthz 里暴露版本号
EXPOSE_VERSION=true
