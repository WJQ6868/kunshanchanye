# ---- 运行期数据（首次启动自动生成，绝不入库）----
server/data/
# 数据库（sqlite 主库 + 两个伴随文件）
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# 日志
*.log
logs/
# 进程号（一键启停脚本在 manual 模式下写这里）
*.pid
server/data/*.pid

# ---- 环境变量（.env.example 才是模板）----
.env
.env.*
!.env.example

# ---- 依赖 ----
node_modules/
.npmcache/
pnpm-lock.yaml.bak

# ---- 构建/缓存产物 ----
dist/
build/
.cache/
*.tsbuildinfo
__pycache__/
*.pyc

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时文件 ----
*.tmp
*.bak
*~
~$*
tmp/
tools/tmp/

# ---- 截图与内部文档（体积大，按需另存）----
screenshots/
docs/
